# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# ИИ-помощник для вопросов вида «Бот: что у меня завтра?» (необязательно).
# Самый простой бесплатный вариант — Google Gemini, ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Либо OpenAI (платно). Если заданы оба ключа, используется OpenAI.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Только для другого OpenAI-совместимого сервера (например, локальный Ollama):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=<имя модели из `ollama list`>

# Адрес личного кабинета
PORTAL_URL=https://lk.asu.ru

# Как загружать страницы после входа: auto | http | selenium
#   auto     — сначала быстрый HTTP-запрос, при неудаче браузер
#   http     — только HTTP
#   selenium — всегда браузер (как в дипломной версии)
FETCH_MODE=auto

# Часовой пояс для ИИ-помощника («что у меня завтра?»)
TIMEZONE=Asia/Barnaul

# Сколько секунд хранить вход пользователя
SESSION_TTL=3600
# Не более N неудачных входов за окно в M секунд
MAX_LOGIN_ATTEMPTS=3
LOGIN_WINDOW=600
# Сколько Chrome может работать одновременно
MAX_BROWSERS=2
